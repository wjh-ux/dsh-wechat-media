{
  "manifest_version": 3,
  "name": "DSH Browser Bridge",
  "version": "1.0.0",
  "description": "Lets DeepSeek Harness (dsh) drive this Chrome through the DevTools protocol. Load unpacked, set the token, leave it running.",
  "permissions": ["debugger", "tabs", "storage", "alarms", "activeTab"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "DSH Bridge - click to (re)connect"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
